# Copy to .env and adjust. Values here are for LOCAL DEVELOPMENT ONLY.

# ---- Kafka ----
KAFKA_IMAGE=apache/kafka:4.1.0
# Local default. Production reference: 24-48 (see ADR-0004). Hard to change later.
KAFKA_TOPIC_PARTITIONS=6

# ---- PostgreSQL (system of record + pgvector) ----
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=insights
POSTGRES_USER=insights
POSTGRES_PASSWORD=insights_dev_pw

# ---- ClickHouse (telemetry events) ----
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
CLICKHOUSE_DB=insights
CLICKHOUSE_USER=insights
CLICKHOUSE_PASSWORD=insights_dev_pw

# ---- SeaweedFS (S3-compatible replay storage) ----
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.47
# Must match infra/seaweedfs/s3.json
S3_ACCESS_KEY=insights_dev_key
S3_SECRET_KEY=insights_dev_secret
S3_REPLAY_BUCKET=session-replays

# ---- Init / tooling images ----
AWS_CLI_IMAGE=amazon/aws-cli:2.37.4
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0

# ---- Ollama (default, free, local LLM) ----
# macOS: run Ollama NATIVELY (Metal GPU): brew install ollama && ollama serve
# Linux / CI: docker compose --profile ollama-docker up -d
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_IMAGE=ollama/ollama:0.34.4
# Chat model must support tool calling. Low-RAM option: qwen2.5:3b
OLLAMA_CHAT_MODEL=qwen2.5:7b
# 768 dimensions. Changing this model changes the pgvector column size (ADR-0005).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
