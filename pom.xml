<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ADR-0001: Spring Boot 4.1 line (latest patch verified in Phase 0). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.sessioninsights</groupId>
    <artifactId>session-insights-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Session Insights</name>
    <description>Open-source session replay and product insights platform</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <modules>
        <module>services/platform-common</module>
        <module>services/platform-db</module>
        <module>services/platform-domain</module>
        <module>services/collector-service</module>
        <module>services/event-processor</module>
        <module>services/analysis-worker</module>
        <module>services/api-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- ADR-0001: Spring AI 2.x requires Boot 4.x. -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- ClickHouse Java client (Apache-2.0); not managed by the Boot BOM. -->
        <clickhouse-client.version>0.10.0</clickhouse-client.version>
        <!-- In-memory token buckets for collector rate limiting (Apache-2.0); not in the Boot BOM. -->
        <bucket4j.version>8.20.0</bucket4j.version>
        <!-- ADR-0003: S3 API via AWS SDK v2 (Apache-2.0); not in the Boot BOM. -->
        <aws-sdk.version>2.55.6</aws-sdk.version>
        <!-- zstd for replay chunk objects (BSD-2-Clause). Also pins the version kafka-clients pulls in. -->
        <zstd-jni.version>1.5.7-20</zstd-jni.version>
        <!-- ADR-0001: surface virtual-thread pinning (Java 21) in local runs and tests -->
        <pinning.trace>-Djdk.tracePinnedThreads=short</pinning.trace>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.sessioninsights</groupId>
                <artifactId>platform-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.sessioninsights</groupId>
                <artifactId>platform-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.sessioninsights</groupId>
                <artifactId>platform-db</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.sessioninsights</groupId>
                <artifactId>platform-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.clickhouse</groupId>
                <artifactId>client-v2</artifactId>
                <version>${clickhouse-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.luben</groupId>
                <artifactId>zstd-jni</artifactId>
                <version>${zstd-jni.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <jvmArguments>${pinning.trace}</jvmArguments>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito as a static agent: the inline mock maker's self-attach is
                             deprecated on JDK 21+. Path comes from dependency:properties below. -->
                        <argLine>-javaagent:${org.mockito:mockito-core:jar} ${pinning.trace}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Exposes ${groupId:artifactId:type} path properties for the surefire argLine.
                 Every module with tests must have mockito-core (via spring-boot-starter-test). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
